<mujoco model="wall_simple">
	<size memory="32M"/>
	<compiler autolimits="true" assetdir="drone" angle="radian" eulerseq="XYZ" coordinate="local" inertiafromgeom="true"/>
	<option integrator="implicitfast" timestep="0.01" density="1.225" viscosity="1.8e-5"/>

	<visual>
		<headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
		<rgba haze="0.15 0.25 0.35 1"/>
		<global glow="0" offwidth="1920" offheight="1080" azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
		<quality offsamples="0"/>
	</visual>

	<default>
		<default class="waypoint">
			<geom type="sphere" size="0.13" rgba="0 1 0 0.5" contype="0" conaffinity="0" group="4"/>
		</default>
	</default>

	<statistic center="0 0 0.1" extent="0.6" meansize="0.05"/>

	<asset>
		<texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
		<texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
		<texture type="cube" name="wall" builtin="flat" mark="random" rgb1="0.4 0.3 0.2" rgb2="0.3 0.2 0.1" markrgb="0.8 0.8 0.8" width="300" height="300"/>
		<material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
		<material name="wall" texture="wall"/>
	</asset>

	<worldbody>
		<light pos="0 0 1.5" dir="0 0 -1" type="spot" active="false"/>
		<geom name="floor" size="4.5 1.5 0.05" pos="4 0 0" type="plane" material="groundplane"/>
		<geom name="wp" class="waypoint" pos="0 0 0"/>
		<geom name="wall" size="0.05 1.5 1" pos="4 0 4" type="box" material="wall"/>
	</worldbody>

	<include file="./drone.xml"/>
</mujoco>
